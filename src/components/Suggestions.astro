---
import defaultData from '../data/suggestions.json';

interface Leg {
    place: string;
    time: string;
    note: string;
    url?: string;
}

interface Route {
    name: string;
    direction: string;
    plannedDay: number;
    plannedLabel: string;
    totalTime: string;
    legs: Leg[];
}

interface Wish {
    name: string;
    status: string;
    statusLabel: string;
    when: string;
    price: string;
    description: string;
    url?: string;
}

const data = Astro.props.suggestionsData || defaultData;
const base = import.meta.env.BASE_URL;
---

<section id="suggestions" class="section">
    <div class="container">
        <h2 class="section-title">{data.title}</h2>
        <p class="section-intro">{data.intro}</p>

        <div class="sugg-routes">
            {data.routes.map((route: Route) => (
                <div class="sugg-route">
                    <div class="sugg-route-head">
                        <div>
                            <h3>{route.name}</h3>
                            <p class="sugg-route-dir">{route.direction} · {route.totalTime}</p>
                        </div>
                        <a href={`${base}day/${route.plannedDay}/`} class="sugg-route-day">{route.plannedLabel}</a>
                    </div>
                    <ol class="sugg-legs">
                        {route.legs.map((leg: Leg) => (
                            <li class="sugg-leg">
                                <div class="sugg-leg-head">
                                    <span class="sugg-leg-place">{leg.place}</span>
                                    <span class="sugg-leg-time">{leg.time}</span>
                                </div>
                                <p class="sugg-leg-note">{leg.note}</p>
                                {leg.url && (
                                    <a href={leg.url} target="_blank" rel="noopener noreferrer" class="sugg-link">Apri in Maps &rarr;</a>
                                )}
                            </li>
                        ))}
                    </ol>
                </div>
            ))}
        </div>

        <h3 class="sugg-wish-title">{data.wishlistTitle}</h3>
        <p class="sugg-wish-intro">{data.wishlistIntro}</p>

        <div class="sugg-wish-grid">
            {data.wishlist.map((w: Wish) => (
                <div class={`sugg-wish sugg-wish-${w.status}`}>
                    <span class="sugg-wish-badge">{w.statusLabel}</span>
                    <h4>{w.name}</h4>
                    <p class="sugg-wish-when">🗓️ {w.when}</p>
                    <p class="sugg-wish-price">🎟️ {w.price}</p>
                    <p class="sugg-wish-desc">{w.description}</p>
                    {w.url && (
                        <a href={w.url} target="_blank" rel="noopener noreferrer" class="sugg-link">Scheda ufficiale &rarr;</a>
                    )}
                </div>
            ))}
        </div>

        <p class="sugg-booking">
            {data.bookingNote}
            {data.bookingUrl && (
                <a href={data.bookingUrl} target="_blank" rel="noopener noreferrer" class="sugg-link"> Biglietteria online &rarr;</a>
            )}
        </p>
    </div>
</section>

<style>
    .sugg-routes {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .sugg-route {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .sugg-route-head {
        padding: 1.1rem 1.3rem;
        border-bottom: 1px solid #eef1f4;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        align-items: flex-start;
        justify-content: space-between;
    }

    .sugg-route-head h3 {
        margin: 0;
        font-size: 1.15rem;
    }

    .sugg-route-dir {
        margin: 0.2rem 0 0;
        font-size: 0.85rem;
        color: var(--color-text-light, #7f8c8d);
    }

    .sugg-route-day {
        flex-shrink: 0;
        font-size: 0.76rem;
        font-weight: 600;
        padding: 0.25rem 0.65rem;
        border-radius: 20px;
        background: #eaf1f7;
        color: var(--color-primary, #1a5276);
        text-decoration: none;
        white-space: nowrap;
    }

    .sugg-route-day:hover {
        background: var(--color-primary, #1a5276);
        color: #fff;
    }

    .sugg-legs {
        list-style: none;
        margin: 0;
        padding: 1.1rem 1.3rem 1.3rem;
        counter-reset: leg;
    }

    .sugg-leg {
        position: relative;
        padding-left: 1.9rem;
        padding-bottom: 1.1rem;
        counter-increment: leg;
    }

    .sugg-leg:last-child { padding-bottom: 0; }

    .sugg-leg::before {
        content: counter(leg);
        position: absolute;
        left: 0;
        top: 0.05rem;
        width: 1.35rem;
        height: 1.35rem;
        border-radius: 50%;
        background: var(--color-primary, #1a5276);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sugg-leg:not(:last-child)::after {
        content: '';
        position: absolute;
        left: 0.64rem;
        top: 1.6rem;
        bottom: 0.35rem;
        width: 2px;
        background: #e0e6ea;
    }

    .sugg-leg-head {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: baseline;
    }

    .sugg-leg-place {
        font-weight: 700;
    }

    .sugg-leg-time {
        font-size: 0.8rem;
        color: var(--color-accent, #b8651b);
        font-weight: 600;
    }

    .sugg-leg-note {
        margin: 0.3rem 0 0;
        font-size: 0.9rem;
        line-height: 1.55;
        color: var(--color-text-light, #55636d);
    }

    .sugg-link {
        display: inline-block;
        margin-top: 0.4rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-primary-light, #2980b9);
        text-decoration: none;
    }

    .sugg-link:hover { text-decoration: underline; }

    .sugg-wish-title {
        margin: 3rem 0 0.4rem;
        font-family: var(--font-display, Georgia, serif);
        font-size: 1.5rem;
        text-align: center;
    }

    .sugg-wish-intro {
        margin: 0 auto 1.6rem;
        max-width: 640px;
        text-align: center;
        color: var(--color-text-light, #7f8c8d);
    }

    .sugg-wish-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .sugg-wish {
        position: relative;
        background: #fff;
        border-radius: 12px;
        padding: 1.4rem 1.4rem 1.3rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        border-top: 4px solid #e0e6ea;
    }

    .sugg-wish-primary { border-top-color: var(--color-accent, #e67e22); }
    .sugg-wish-alt     { border-top-color: var(--color-primary-light, #2980b9); }

    .sugg-wish-badge {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        background: #f2f5f7;
        color: var(--color-text-light, #55636d);
    }

    .sugg-wish h4 {
        margin: 0.6rem 0 0.5rem;
        font-family: var(--font-display, Georgia, serif);
        font-size: 1.25rem;
    }

    .sugg-wish-when,
    .sugg-wish-price {
        margin: 0.2rem 0;
        font-size: 0.88rem;
        font-weight: 500;
    }

    .sugg-wish-desc {
        margin: 0.8rem 0 0;
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--color-text-light, #55636d);
    }

    .sugg-booking {
        margin-top: 1.6rem;
        padding: 1rem 1.2rem;
        background: #f7fbfd;
        border-left: 4px solid var(--color-primary-light, #2980b9);
        border-radius: 8px;
        font-size: 0.9rem;
        line-height: 1.6;
    }
</style>

---
const defaultStages = [
    { icon: "📍", title: "Partenza", place: "Alessandria, Piemonte", date: "Domenica 23 Agosto", highlight: false },
    { icon: "🌊", title: "Tappa 1", place: "Montemarciano (Marche)", date: "23 Agosto - 1 notte", highlight: false },
    { icon: "⛰️", title: "Tappa 2", place: "Vieste (Gargano)", date: "24-26 Agosto - 2 notti", highlight: true },
    { icon: "🏘️", title: "Tappa 3", place: "Ostuni (Alto Salento)", date: "26 Ago - 1 Set - 6 notti", highlight: true },
    { icon: "🕳️", title: "Tappa 4", place: "Matera (Basilicata)", date: "1 Settembre - 1 notte", highlight: true },
    { icon: "🚲", title: "Tappa 5", place: "Costa dei Trabocchi (Abruzzo)", date: "2 Settembre - 1 notte", highlight: false },
    { icon: "🧂", title: "Tappa 6", place: "Cervia e Ravenna (Romagna)", date: "3 Settembre - 1 notte", highlight: false },
    { icon: "📍", title: "Ritorno", place: "Alessandria", date: "Venerdì 4 Settembre", highlight: false },
];
const stages = Astro.props.stagesData || defaultStages;
const intro = Astro.props.introText || "Tredici giorni in auto: il Gargano, Ostuni come campo base, e un rientro con Matera, i trabocchi e Ravenna.";
---

<section id="overview" class="section">
    <div class="container">
        <h2 class="section-title">Panoramica del Viaggio</h2>
        <p class="section-intro">{intro}</p>
        <div class="overview-grid">
            {stages.map(s => (
                <div class={`overview-card ${s.highlight ? 'highlight' : ''}`}>
                    <div class="overview-card-icon">{s.icon}</div>
                    <h3>{s.title}</h3>
                    <p>{s.place}</p>
                    <span class="overview-date">{s.date}</span>
                </div>
            ))}
        </div>
    </div>
</section>
